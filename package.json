{
  "name": "claws-ts",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run"
  },
  "keywords": [
    "khmer",
    "khmer-nlp",
    "tokenizer",
    "segmentation",
    "wasm",
    "tflite",
    "glnn"
  ],
  "author": "Mostly LLM",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-core": "^4.9.0",
    "@tensorflow/tfjs-tflite": "^0.0.1-alpha.10"
  },
  "devDependencies": {
    "@tensorflow/tfjs-backend-cpu": "^4.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}